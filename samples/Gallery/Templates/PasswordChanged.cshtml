---
subject: Security Alert: Password changed for your Contoso account
layout: _Layouts/Base
---
@model Contoso.Emails.PasswordChangedModel

<div class="alert-banner alert-warning">
    Security Notification: Your password was recently modified.
</div>

<Heading Level="1">Password Changed</Heading>
<p>Hello @Model.Name,</p>
<p>Your Contoso account password was successfully updated on <strong>@Model.ChangeTime</strong>.</p>

<table border="0" cellpadding="4" cellspacing="0" width="100%" style="font-size: 14px; margin: 16px 0; color: #475569;">
    <tr>
        <td style="width: 140px; font-weight: bold;">Device:</td>
        <td>@Model.Device</td>
    </tr>
    <tr>
        <td style="font-weight: bold;">Location:</td>
        <td>@Model.Location</td>
    </tr>
    <tr>
        <td style="font-weight: bold;">IP Address:</td>
        <td>@Model.IpAddress</td>
    </tr>
</table>

<p>If you made this change, no further action is necessary.</p>

<div class="alert-banner alert-danger">
    <p style="margin: 0;"><strong>Didn't make this change?</strong> Your account may be compromised. Lock your account and reset credentials immediately:</p>
</div>

<Spacer Height="16" />
<Button Href="@Model.SecureAccountUrl" BgColor="#dc2626">Secure Account Now</Button>
<Spacer Height="20" />
<Divider />
<p style="font-size: 13px; color: #64748b;"><T.Try Key="security.notice" /></p>

