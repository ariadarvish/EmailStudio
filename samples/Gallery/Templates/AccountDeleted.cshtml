---
subject: Confirmation: Your Contoso account has been closed
layout: _Layouts/Base
---
@model Contoso.Emails.AccountDeletedModel

<div class="alert-banner alert-warning">
    Account Status: Closed and Scheduled for Purge
</div>

<Heading Level="1">Account Closed</Heading>
<p>Hello @Model.Name,</p>
<p>This message confirms that your Contoso account (<strong>@Model.Email</strong>) has been permanently closed as requested on @Model.ClosedDate.</p>
<p>Per our data retention policies, all personal data, API tokens, and templates associated with your workspace will be permanently wiped within @Model.GracePeriodDays days.</p>

<Spacer Height="16" />
<div class="alert-banner alert-danger">
    <p style="margin: 0;">Changed your mind? You can restore your account within @Model.GracePeriodDays days:</p>
</div>

<Spacer Height="16" />
<Button Href="@Model.RestoreUrl" BgColor="#2563eb">Restore My Account</Button>
<Spacer Height="20" />
<Divider />
<p style="font-size: 13px; color: #64748b;">After @Model.GracePeriodDays days, account recovery will no longer be possible.</p>

