---
subject: Reset your Contoso password, {Name}
layout: _Layouts/Base
---
@model Contoso.Emails.ResetPasswordModel

<Heading Level="1">Password Reset Request</Heading>
<p>Hello @Model.Name,</p>
<p>We received a request to reset your Contoso account password. Click the button below to choose a new password:</p>

<Spacer Height="20" />
<Button Href="@Model.ResetUrl" BgColor="#0f172a">Reset Password</Button>
<Spacer Height="20" />

<div class="alert-banner alert-warning">
    <p style="margin: 0;"><T.Try Key="security.notice" /></p>
</div>

<p class="text-muted">Requested from IP: <strong>@Model.RequestIp</strong> on @Model.RequestTime.</p>
<Divider />
<p style="font-size: 13px; color: #64748b;">This password reset link will expire in 30 minutes.</p>

