<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-email-preview</ToolCommandName>
    <PackageId>EmailStudio.Tool</PackageId>
    <Description>Local preview CLI tool for EmailStudio templates.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmailStudio\EmailStudio.csproj" />
    <ProjectReference Include="..\EmailStudio.Preview\EmailStudio.Preview.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md"
          Pack="true"
          PackagePath=""
          Visible="false" />
  </ItemGroup>

</Project>

